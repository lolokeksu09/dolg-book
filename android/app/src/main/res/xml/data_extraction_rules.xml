<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Offline customer/ledger data must not transfer automatically. -->
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
